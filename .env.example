# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
MONGO_URI=mongodb://localhost:27017/retro

# JWT Secrets (min 256-bit / >=32 chars)
ACCESS_TOKEN_SECRET=your-access-token-secret-min-256-bits
ACCESS_TOKEN_EXPIRY=86400
REFRESH_TOKEN_SECRET=your-refresh-token-secret-min-256-bits
REFRESH_TOKEN_EXPIRY=604800

# AI Service (OpenAI-compatible provider)
# Local default: http://127.0.0.1:8319/v1 + dummy key + claude-opus-5
# On Render set these to your live endpoint (Groq, OpenRouter, etc.)
AI_BASE_URL=http://127.0.0.1:8319/v1
AI_API_KEY=dummy
AI_MODEL=claude-opus-5

# Email Service (Nodemailer / Mailtrap SMTP)
MAILTRAP_SMTP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_SMTP_PORT=587
MAILTRAP_SMTP_USER=your-mailtrap-user
MAILTRAP_SMTP_PASS=your-mailtrap-pass

# Frontend URL (for CORS in production)
FRONTEND_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000

# Stripe Configuration (optional - app runs without it)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Stripe Price IDs (get these from Stripe Dashboard after creating products)
STRIPE_PRICE_PRO_MONTHLY=price_pro_monthly_id
STRIPE_PRICE_PRO_YEARLY=price_pro_yearly_id
STRIPE_PRICE_PREMIUM_MONTHLY=price_premium_monthly_id
STRIPE_PRICE_PREMIUM_YEARLY=price_premium_yearly_id
