<!-- Notes Section Content -->
<div class="flex notes-layout" style="height: 100%; min-height: 0;">
    <!-- Sidebar with Notes List -->
    <div
        class="w-80 bg-gray-100 border-r border-gray-200 flex flex-col rounded-r-3xl notes-sidebar"
        style="height: 100%; min-height: 0;"
    >
        <div
            class="p-6 border-b border-gray-200 bg-white rounded-tr-3xl"
        >
            <div class="flex items-center justify-between mb-4">
                <h2 class="text-xl font-semibold text-gray-800">
                    Notes
                </h2>
                <button
                    onclick="createNewNote()"
                    class="tooltip flex items-center justify-center w-10 h-10 text-center text-white duration-200 bg-black border-2 border-black rounded-full hover:bg-transparent hover:border-black hover:text-black focus:outline-none text-sm"
                    data-tooltip="Create a new note"
                >
                    <i class="fas fa-plus"></i>
                </button>
            </div>

            <div class="relative">
                <i
                    class="fas fa-search absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400"
                ></i>
                <input
                    type="text"
                    placeholder="Search notes..."
                    class="w-full pl-10 pr-4 py-3 bg-gray-50 border border-gray-200 rounded-full text-gray-800 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-black focus:border-transparent"
                    id="searchInput"
                />
            </div>
        </div>

        <div class="flex-1 overflow-y-auto p-4" style="min-height: 0;">
            <div class="space-y-4" id="notesList"></div>
        </div>
    </div>

    <!-- Editor Area -->
    <div class="flex-1 flex flex-col bg-gray-50 p-6 relative notes-editor" style="min-height: 0;">
        <div
            class="flex flex-col bg-white rounded-3xl shadow-lg h-full relative"
            style="min-height: 0;"
        >
            <div class="px-8 py-6 border-b border-gray-100 notes-topbar">
                <div class="flex items-center justify-between notes-topbar-row">
                    <button
                        onclick="backToNotesList()"
                        class="notes-back-btn"
                        aria-label="Back to notes list"
                    >
                        <i class="fas fa-arrow-left"></i>
                        Notes
                    </button>
                    <button
                        onclick="toggleNotesActions()"
                        class="notes-actions-btn"
                        id="notesActionsBtn"
                        aria-label="Note actions"
                        aria-haspopup="true"
                        aria-expanded="false"
                    >
                        &#10022;
                    </button>
                    <input
                        type="text"
                        value=""
                        placeholder="Untitled Note"
                        class="text-2xl font-medium tracking-tighter text-gray-800 bg-transparent border-none focus:outline-none focus:ring-2 focus:ring-purple-500 rounded px-2 py-1"
                        id="noteTitle"
                    />

                    <div class="flex items-center space-x-3 notes-actions">
                        <button
                            onclick="enhanceWithRetro()"
                            class="tooltip flex items-center justify-center px-6 py-2.5 text-center text-white duration-200 bg-black border-2 border-black rounded-full hover:bg-transparent hover:border-black hover:text-black focus:outline-none focus-visible:outline-black text-sm focus-visible:ring-black"
                            data-tooltip="Enhance your note with AI assistance"
                        >
                            <i class="fas fa-magic mr-2"></i>
                            Enhance with AI
                        </button>

                        <button
                            onclick="syncNotes()"
                            class="tooltip flex items-center justify-center px-6 py-2.5 text-center text-white duration-200 bg-purple-600 border-2 border-purple-600 rounded-full hover:bg-transparent hover:border-purple-600 hover:text-purple-600 focus:outline-none text-sm"
                            data-tooltip="Sync your notes across devices"
                        >
                            <i class="fas fa-sync-alt mr-2"></i>
                            Sync
                        </button>
                        <button
                            onclick="saveNote()"
                            class="tooltip flex items-center justify-center px-6 py-2.5 text-center text-white duration-200 bg-green-600 border-2 border-green-600 rounded-full hover:bg-transparent hover:border-green-600 hover:text-green-600 focus:outline-none focus-visible:outline-green-600 text-sm"
                            data-tooltip="Save your note locally and to the server"
                        >
                            <i class="fas fa-save mr-2"></i>
                            Save
                        </button>
                        <button
                            onclick="openReadMode()"
                            class="tooltip flex items-center justify-center px-6 py-2.5 text-center text-purple-600 duration-200 bg-white border-2 border-purple-600 rounded-full hover:bg-purple-600 hover:text-white focus:outline-none text-sm"
                            data-tooltip="Open in read mode"
                        >
                            <i class="fas fa-book-open mr-2"></i>
                            Read Mode
                        </button>
                    </div>
                </div>
                <div class="notes-actions-sheet" id="notesActionsSheet" role="menu" aria-label="Note actions">
                    <div class="notes-actions-title">Note actions</div>
                    <button role="menuitem" onclick="notesMenuAction('enhance')">
                        <i class="fas fa-magic"></i>
                        Enhance with AI
                    </button>
                    <button role="menuitem" onclick="notesMenuAction('sync')">
                        <i class="fas fa-sync-alt"></i>
                        Sync
                    </button>
                    <button role="menuitem" onclick="notesMenuAction('save')">
                        <i class="fas fa-save"></i>
                        Save
                    </button>
                    <button role="menuitem" onclick="notesMenuAction('read')">
                        <i class="fas fa-book-open"></i>
                        Read Mode
                    </button>
                </div>
            </div>

            <div
                class="flex-1 p-8 notes-editor-body"
                style="padding-top: 24px; overflow-y: auto; min-height: 0;"
            >
                <div
                    id="editor"
                    class="h-full bg-transparent rounded-2xl"
                    style="min-height: 400px;"
                ></div>
            </div>

        </div>
    </div>
</div>

<!-- Include Quill Editor and Marked.js -->
<script defer src="https://cdn.quilljs.com/1.3.6/quill.min.js"></script>
<script defer src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

<!-- Notes Styles -->
<link rel="stylesheet" href="/css/app.css" />

<style>
    /* Styled scrollbar for Quill editor */
    .ql-container {
        font-family: "Space Grotesk", sans-serif;
    }

    .ql-editor::-webkit-scrollbar {
        width: 8px;
    }

    .ql-editor::-webkit-scrollbar-track {
        background: transparent;
        margin: 8px 0;
    }

    .ql-editor::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 10px;
        border: 2px solid transparent;
        background-clip: content-box;
    }

    .ql-editor::-webkit-scrollbar-thumb:hover {
        background: #94a3b8;
        background-clip: content-box;
    }

    /* Dark mode scrollbar for Quill editor */
    [data-theme="dark"] .ql-editor::-webkit-scrollbar-thumb {
        background: #4a5568;
    }

    [data-theme="dark"] .ql-editor::-webkit-scrollbar-thumb:hover {
        background: #718096;
    }

    /* Firefox scrollbar styling for Quill editor */
    .ql-editor {
        scrollbar-width: thin;
        scrollbar-color: #cbd5e1 transparent;
    }

    [data-theme="dark"] .ql-editor {
        scrollbar-color: #4a5568 transparent;
    }

    /* Styled scrollbar for notes list sidebar */
    .flex-1.overflow-y-auto.p-4::-webkit-scrollbar {
        width: 8px;
    }

    .flex-1.overflow-y-auto.p-4::-webkit-scrollbar-track {
        background: transparent;
        margin: 8px 0;
    }

    .flex-1.overflow-y-auto.p-4::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 10px;
        border: 2px solid transparent;
        background-clip: content-box;
    }

    .flex-1.overflow-y-auto.p-4::-webkit-scrollbar-thumb:hover {
        background: #94a3b8;
        background-clip: content-box;
    }

    /* Dark mode scrollbar for notes list */
    [data-theme="dark"] .flex-1.overflow-y-auto.p-4::-webkit-scrollbar-thumb {
        background: #4a5568;
    }

    [data-theme="dark"] .flex-1.overflow-y-auto.p-4::-webkit-scrollbar-thumb:hover {
        background: #718096;
    }

    /* Firefox scrollbar for notes list */
    .flex-1.overflow-y-auto.p-4 {
        scrollbar-width: thin;
        scrollbar-color: #cbd5e1 transparent;
    }

    [data-theme="dark"] .flex-1.overflow-y-auto.p-4 {
        scrollbar-color: #4a5568 transparent;
    }

    /* Dark mode support for notes section */
    [data-theme="dark"] .bg-gray-100 {
        background: var(--bg-primary);
    }

    [data-theme="dark"] .bg-gray-50 {
        background: var(--bg-primary);
    }

    [data-theme="dark"] .bg-white {
        background: var(--bg-secondary);
    }

    [data-theme="dark"] .border-gray-200,
    [data-theme="dark"] .border-gray-100 {
        border-color: var(--border-color);
    }

    /* Prevent text selection on interactive elements */
    button,
    .note-item,
    .tooltip,
    i.fas,
    i.far {
        user-select: none;
        -webkit-user-select: none;
        -moz-user-select: none;
        -ms-user-select: none;
    }

    /* Ensure icons don't capture pointer events */
    button i.fas,
    button i.far {
        pointer-events: none;
    }

    [data-theme="dark"] .text-gray-800,
    [data-theme="dark"] .text-gray-700,
    [data-theme="dark"] .text-gray-600,
    [data-theme="dark"] .text-gray-500 {
        color: var(--text-primary);
    }

    [data-theme="dark"] .text-gray-400 {
        color: var(--text-secondary);
    }

    [data-theme="dark"] input[type="text"],
    [data-theme="dark"] #noteTitle {
        background: var(--bg-tertiary);
        color: var(--text-primary);
        border-color: var(--border-color);
    }

    /* Allow text selection in inputs */
    input[type="text"],
    #noteTitle,
    #searchInput {
        user-select: text;
        -webkit-user-select: text;
        -moz-user-select: text;
        -ms-user-select: text;
    }

    [data-theme="dark"] input::placeholder {
        color: var(--text-secondary);
    }

    [data-theme="dark"] .note-item {
        background: var(--bg-secondary) !important;
        border-color: var(--border-color);
    }

    [data-theme="dark"] .note-item:hover {
        background: var(--bg-tertiary) !important;
    }

    /* Mobile layout hooks (desktop keeps the Tailwind side-by-side row) */
    .notes-layout {
        min-height: 0;
    }

    .notes-sidebar {
        min-height: 0;
    }

    .notes-editor {
        min-width: 0;
    }

    .notes-topbar {
        min-width: 0;
    }

    .notes-actions {
        min-width: 0;
    }

    .notes-editor-body {
        min-width: 0;
    }

    /* Back button — mobile master-detail only (hidden on desktop) */
    .notes-back-btn {
        display: none;
    }

    /* "Note actions" menu — mobile only (hidden on desktop) */
    .notes-actions-btn {
        display: none;
    }

    .notes-actions-sheet {
        display: none;
    }

    .notes-actions-title {
        display: none;
    }

    @media (max-width: 768px) {
        /* Master-detail: list and editor each take the full pane, one at a
           time. Root carries .notes-show-editor while a note is open. */
        .notes-layout {
            flex-direction: column;
        }

        .notes-layout:not(.notes-show-editor) .notes-editor {
            display: none;
        }

        .notes-layout:not(.notes-show-editor) .notes-sidebar {
            width: 100%;
            height: auto;
            flex: 1;
            min-height: 0;
            border-right: none;
            border-radius: 1.5rem;
        }

        .notes-layout.notes-show-editor .notes-sidebar {
            display: none;
        }

        .notes-layout.notes-show-editor .notes-editor {
            flex: 1;
            min-height: 0;
            padding: 0.75rem;
        }

        .notes-back-btn {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            flex: 0 0 auto;
            padding: 0.5rem 0.9rem;
            background: var(--bg-tertiary);
            color: var(--text-primary);
            border: 1px solid var(--border-color);
            border-radius: 999px;
            font-size: 0.85rem;
            font-weight: 600;
            cursor: pointer;
        }

        .notes-topbar {
            padding: 1rem;
            position: relative;
        }

        .notes-topbar-row {
            flex-wrap: wrap;
            gap: 0.75rem;
        }

        /* The 4-button block is replaced by the ✦ menu on mobile */
        .notes-actions {
            display: none;
        }

        .notes-actions-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex: 0 0 auto;
            margin-left: auto;
            width: 40px;
            height: 40px;
            background: #000;
            color: #fff;
            border: 2px solid #000;
            border-radius: 50%;
            font-size: 1.1rem;
            line-height: 1;
            cursor: pointer;
        }

        [data-theme="dark"] .notes-actions-btn {
            background: var(--text-primary);
            border-color: var(--text-primary);
            color: var(--bg-primary);
        }

        .notes-actions-sheet {
            position: absolute;
            top: calc(100% - 0.5rem);
            right: 1rem;
            min-width: 220px;
            background: var(--bg-secondary, #fff);
            border: 1px solid var(--border-color, #e5e7eb);
            border-radius: 1rem;
            box-shadow: 0 18px 45px -12px rgba(0, 0, 0, 0.3);
            padding: 0.5rem;
            z-index: 50;
        }

        .notes-actions-sheet.open {
            display: flex;
            flex-direction: column;
        }

        .notes-actions-title {
            display: block;
            padding: 0.5rem 0.75rem 0.25rem;
            font-size: 0.7rem;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: var(--text-secondary, #6b7280);
        }

        .notes-actions-sheet button {
            display: flex;
            align-items: center;
            gap: 0.65rem;
            width: 100%;
            padding: 0.7rem 0.75rem;
            background: transparent;
            border: none;
            border-radius: 0.65rem;
            color: var(--text-primary, #1f2937);
            font-size: 0.9rem;
            font-weight: 500;
            text-align: left;
            cursor: pointer;
        }

        .notes-actions-sheet button:hover {
            background: var(--bg-tertiary, #f3f4f6);
        }

        .notes-actions-sheet button i {
            width: 1.1rem;
            text-align: center;
            opacity: 0.7;
        }

        #noteTitle {
            /* Own row under the back button on all mobile widths
               (deterministic — never half-wrapped beside it) */
            flex: 1 1 100%;
            min-width: 0;
            font-size: 1.125rem;
        }

        .notes-editor-body {
            padding: 1rem !important;
        }

        /* Single scrollable toolbar row instead of a tall wrapped stack */
        .notes-editor-body .ql-toolbar.ql-snow {
            display: flex;
            overflow-x: auto;
            gap: 0.25rem;
            padding: 0.5rem;
        }

        .notes-editor-body .ql-toolbar.ql-snow .ql-formats {
            flex: 0 0 auto;
            margin-right: 0.5rem;
        }
    }
</style>

<!-- Notes JavaScript -->
<script defer src="/js/notes.js"></script>

