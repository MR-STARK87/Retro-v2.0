        color: #b45309;
        border-color: #fde68a;
    }

    .icon-btn.favorite.active {
        background: #fef2f2;
        color: #dc2626;
        border-color: #fecaca;
    }

    /* Prevent text selection on interactive elements */
    button,
    .flashcard,
    .fc-dropdown-item,
    .modal-overlay,
    i.fas,
    i.far {
        user-select: none;
        -webkit-user-select: none;
    }

    /* Ensure icons don't capture pointer events */
    button i.fas,
    button i.far {
        pointer-events: none;
    }

    /* Allow text selection in inputs */
    input[type="text"],
    textarea {
        user-select: text;
        -webkit-user-select: text;
    }

    /* Styled scrollbars */
    #flashcardsSection .overflow-y-auto::-webkit-scrollbar {
