    }

    .fc-dropdown-btn:focus {
        outline: none;
        box-shadow: 0 0 0 2px black;
    }

    .fc-dropdown-btn i {
        transition: transform 0.2s ease;
        pointer-events: none;
    }

    .fc-dropdown.open .fc-dropdown-btn i.fa-chevron-down {
        transform: rotate(180deg);
    }

    .fc-dropdown-menu {
        position: absolute;
        top: calc(100% + 0.5rem);
        left: 0;
        right: 0;
