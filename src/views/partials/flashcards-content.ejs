<!-- Flashcards Section Content -->
<div style="height: 100%; display: flex; flex-direction: column; overflow: hidden; background: var(--bg-primary);">
    <!-- Header -->
    <div class="px-6 pt-6 pb-4">
        <div class="flex items-start justify-between gap-4 flex-wrap">
            <div>
                <div class="flex items-center gap-3">
                    <h2 class="text-2xl font-semibold tracking-tight text-gray-800" style="font-family: 'Space Grotesk', sans-serif;">
                        Flashcards
                    </h2>
                    <span id="cardsCount" class="text-xs font-semibold text-gray-600 bg-gray-100 border border-gray-200 rounded-full px-2.5 py-0.5">0</span>
                </div>
                <p class="text-sm text-gray-500 mt-0.5">
                    <span id="cardsSubCount">0 cards</span> · Click a card to flip it
                </p>
            </div>

            <div class="flex items-center gap-2.5 flex-wrap justify-end">
                <!-- Search -->
                <div class="relative">
                    <i class="fas fa-search absolute left-3.5 top-1/2 transform -translate-y-1/2 text-gray-400 text-sm pointer-events-none"></i>
                    <input
                        type="text"
                        id="searchInput"
                        placeholder="Search cards..."
                        oninput="handleSearch()"
                        class="w-44 lg:w-56 pl-10 pr-4 py-2.5 bg-white border-2 border-gray-200 rounded-full text-sm text-gray-800 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-black focus:border-transparent transition-colors duration-200"
                        style="font-family: 'IBM Plex Sans', sans-serif;"
                    />
                </div>

                <!-- Difficulty Filter -->
                <div class="fc-dropdown" id="difficultyDropdownContainer">
                    <button type="button" class="fc-dropdown-btn" id="difficultyDropdownBtn" onclick="toggleCustomDropdown('difficulty')">
                        <i class="fas fa-signal text-gray-400 text-xs"></i>
                        <span id="difficultyDropdownText">All levels</span>
                        <i class="fas fa-chevron-down text-xs opacity-60"></i>
                    </button>
                    <div class="fc-dropdown-menu" id="difficultyDropdownMenu">
                        <div class="fc-dropdown-item" onclick="selectDifficultyFilter('', 'All levels')">All levels</div>
                        <div class="fc-dropdown-item" onclick="selectDifficultyFilter('easy', 'Easy')"><span class="fc-dot fc-dot--easy"></span>Easy</div>
                        <div class="fc-dropdown-item" onclick="selectDifficultyFilter('medium', 'Medium')"><span class="fc-dot fc-dot--medium"></span>Medium</div>
                        <div class="fc-dropdown-item" onclick="selectDifficultyFilter('hard', 'Hard')"><span class="fc-dot fc-dot--hard"></span>Hard</div>
                    </div>
                </div>

                <!-- Tag Filter -->
                <div class="fc-dropdown" id="tagDropdownContainer">
                    <button type="button" class="fc-dropdown-btn" id="tagDropdownBtn" onclick="toggleCustomDropdown('tag')">
                        <i class="fas fa-tag text-gray-400 text-xs"></i>
                        <span id="tagDropdownText">All tags</span>
                        <i class="fas fa-chevron-down text-xs opacity-60"></i>
                    </button>
                    <div class="fc-dropdown-menu" id="tagDropdownMenu">
                        <div class="fc-dropdown-item" onclick="selectTagFilter('', 'All tags')">All tags</div>
                    </div>
                </div>

                <!-- Actions -->
                <button
                    onclick="openAIGenerateModal()"
                    class="tooltip fc-pill fc-pill--purple"
                    data-tooltip="Generate flashcards from a note with AI"
                >
                    <i class="fas fa-magic"></i>
                    Generate
                </button>

                <button
                    id="flashCreateBtn"
                    onclick="openCreateModal()"
                    class="tooltip fc-pill fc-pill--black"
                    data-tooltip="Create a new flashcard"
                >
                    <i class="fas fa-plus"></i>
                    New card
                </button>
            </div>
        </div>
    </div>

    <!-- Cards Grid -->
    <div class="flex-1 overflow-y-auto px-6 pb-6" style="min-height: 0;">
        <div id="loadingState" class="text-center py-20">
            <i class="fas fa-circle-notch fa-spin text-2xl text-gray-400"></i>
            <p class="text-sm text-gray-500 mt-3">Loading your deck…</p>
        </div>
        <div id="cardsGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5" style="display: none;">
            <!-- Cards will be rendered here -->
        </div>
        <div id="emptyState" class="text-center py-16" style="display: none;">
            <div class="max-w-md mx-auto bg-white border-2 border-gray-200 rounded-3xl shadow-lg p-10">
                <div class="w-16 h-16 rounded-full bg-gray-100 border-2 border-gray-200 flex items-center justify-center mx-auto">
                    <i class="fas fa-clone text-xl text-gray-400"></i>
                </div>
                <h3 class="text-lg font-semibold text-gray-800 mt-5" style="font-family: 'Space Grotesk', sans-serif;">No flashcards yet</h3>
                <p class="text-sm text-gray-500 mt-1.5 mb-6">Create your first card, or let AI turn one of your notes into a deck.</p>
                <div class="flex gap-3 justify-center flex-wrap">
                    <button onclick="openCreateModal()" class="fc-pill fc-pill--black">
                        <i class="fas fa-plus"></i>Create a card
                    </button>
                    <button onclick="openAIGenerateModal()" class="fc-pill fc-pill--purple">
                        <i class="fas fa-magic"></i>Generate from notes
                    </button>
                </div>
            </div>
        </div>
        <div id="errorState" class="text-center py-16" style="display: none;">
            <div class="max-w-md mx-auto bg-white border-2 border-gray-200 rounded-3xl shadow-lg p-10">
                <div class="w-16 h-16 rounded-full bg-red-50 border-2 border-red-100 flex items-center justify-center mx-auto">
                    <i class="fas fa-exclamation-circle text-xl text-red-500"></i>
                </div>
                <h3 class="text-lg font-semibold text-gray-800 mt-5" style="font-family: 'Space Grotesk', sans-serif;">Couldn't load your deck</h3>
                <p class="text-sm text-gray-500 mt-1.5 mb-6" id="errorMessage"></p>
                <button onclick="loadFlashcards()" class="fc-pill fc-pill--black mx-auto">
                    <i class="fas fa-redo"></i>Try again
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Flashcards Styles -->
<style>
    /* ===== Pill buttons (match chat/notes action buttons) ===== */
