        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 12px;
        overflow-x: auto;
    }

    /* Markdown tables */
    .md-table-wrap {
        overflow-x: auto;
        margin: 0.5rem 0;
