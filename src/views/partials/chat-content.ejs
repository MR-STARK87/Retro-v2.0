    .md-copy-btn:hover {
        opacity: 1 !important;
        background: rgba(255, 255, 255, 0.18);
    }

    .md-copy-btn.copied {
        opacity: 1 !important;
        color: #10b981;
        border-color: rgba(16, 185, 129, 0.5);
    }

    .md-pre code {
