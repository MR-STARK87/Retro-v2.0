    /* Markdown content in assistant bubbles */
    .md-body {
        white-space: normal;
        min-width: 0;
    }

    .md-body .md-p {
        margin: 0;
    }

    .md-body .md-p + .md-p {
        margin-top: 0.5rem;
    }

    .md-body .md-heading {
        margin: 0.75rem 0 0.35rem;
        font-family: "Space Grotesk", sans-serif;
