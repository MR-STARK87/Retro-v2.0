    }

    .md-copy-btn {
        position: absolute;
        top: 0.4rem;
        right: 0.4rem;
        width: 26px;
        height: 26px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(255, 255, 255, 0.15);
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.08);
        color: #fff;
        opacity: 0;
        cursor: pointer;
        font-size: 0.7rem;
        transition:
            opacity 0.15s ease,
            background-color 0.15s ease;
    }

    .md-pre:hover .md-copy-btn {
        opacity: 0.65;
    }

    .md-copy-btn:hover {
        opacity: 1 !important;
        background: rgba(255, 255, 255, 0.18);
    }

    .md-copy-btn.copied {
        opacity: 1 !important;
        color: #10b981;
        border-color: rgba(16, 185, 129, 0.5);
    }

    .md-pre code {
        font-family: "IBM Plex Mono", ui-monospace, Consolas, monospace;
        font-size: 0.82rem;
        line-height: 1.5;
        white-space: pre;
    }

    /* Message meta row (timestamp + copy) - overlays the bubble bottom-right
       on hover so it never reserves space below the text */
    .msg-meta {
        position: absolute;
        right: 0.7rem;
        bottom: 0.35rem;
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 0.4rem;
        padding: 0.1rem 0.45rem;
        border-radius: 8px;
        background: inherit;
        visibility: hidden;
    }

    .chat-bubble:hover .msg-meta {
        visibility: visible;
    }

    .msg-timestamp {
        font-size: 0.65rem;
        color: currentColor;
        opacity: 0;
        transition: opacity 0.15s ease;
        user-select: none;
    }

    .chat-bubble:hover .msg-timestamp {
        opacity: 0.5;
    }

    .msg-copy-btn {
        width: 22px;
        height: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: none;
        border-radius: 6px;
        background: transparent;
        color: currentColor;
        opacity: 0;
        cursor: pointer;
        font-size: 0.7rem;
        transition:
            opacity 0.15s ease,
            background-color 0.15s ease;
    }

    .chat-bubble:hover .msg-copy-btn {
        opacity: 0.55;
    }

    .msg-copy-btn:hover {
        opacity: 1 !important;
