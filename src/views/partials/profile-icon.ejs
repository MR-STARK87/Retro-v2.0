                <span>Light</span>
                <i class="fas fa-check theme-check" id="lightCheck" style="display: none;"></i>
            </div>
            <div class="menu-item theme-option" onclick="setTheme('dark')">
                <i class="fas fa-moon"></i>
                <span>Dark</span>
                <i class="fas fa-check theme-check" id="darkCheck" style="display: none;"></i>
            </div>
        </div>

        <div class="menu-item menu-item-upgrade" id="upgradeMenuItem" onclick="openUpgrade()" style="display: none;" role="menuitem">
            <i class="fas fa-star"></i>
            <span>Upgrade to Pro</span>
        </div>

        <div class="menu-item menu-item-danger" onclick="handleLogout()" role="menuitem">
            <i class="fas fa-sign-out-alt"></i>
            <span>Sign out</span>
        </div>
    </div>
</div>

<!-- Profile Modal — Quiet Card -->
<div id="profileModal" class="profile-modal" style="display: none;" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="profileName">
    <div class="profile-modal-content calm-card">
        <button onclick="closeProfile()" class="calm-close" aria-label="Close profile">
            <i class="fas fa-times"></i>
        </button>

        <!-- Hero -->
        <div class="calm-hero">
            <div class="calm-avatar-wrap">
                <div class="profile-avatar" id="profileAvatar">
                    <span id="profileInitials" class="avatar-initials">R</span>
                    <i id="profileAvatarIcon" class="fas fa-user avatar-icon" style="display:none;"></i>
                </div>
                <span class="avatar-tier-dot tier-free" id="profileTierDot" aria-hidden="true"></span>
            </div>
            <div class="calm-name-row">
                <h2 id="profileName" class="calm-name">Loading...</h2>
                <span id="profileVerified" class="verified-pill" style="display: none;">
                    <i class="fas fa-check"></i> Verified
                </span>
            </div>
            <p id="profileUsername" class="calm-username">@username</p>
            <p id="profileEmailHero" class="calm-email">email@example.com</p>
            <p id="profileVerifyHint" class="calm-verify-hint" style="display: none;">Check your inbox to verify your email</p>
        </div>

        <!-- One quiet caption replaces the ledger -->
        <p class="calm-caption">
            <i id="profileTierIcon" class="fas fa-user tier-icon tier-free"></i>
            <span id="profileTier">Free Tier</span>
            <span class="calm-caption-dot" aria-hidden="true">·</span>
            <span>Member since <span id="profileJoined">—</span></span>
        </p>

        <!-- Tier CTA -->
        <div class="dossier-tier-strip tier-free" id="profileTierStrip">
            <div class="tier-strip-copy">
                <i id="profileTierStripIcon" class="fas fa-leaf"></i>
                <div>
                    <p class="tier-strip-title" id="profileTierStripTitle">Free — Starter</p>
                    <p class="tier-strip-sub" id="profileTierStripSub">25 notes · 100 cards · Basic chat</p>
                </div>
            </div>
            <button class="tier-strip-action" id="profileTierAction" onclick="openUpgrade()">
                <span id="profileTierActionText">Upgrade</span>
                <i class="fas fa-arrow-right"></i>
            </button>
        </div>

        <!-- Footer actions -->
        <div class="calm-footer">
            <button class="calm-btn" onclick="closeProfile(); openMemory();">Memory</button>
            <button class="calm-btn calm-btn-danger" onclick="handleLogout()">Sign out</button>
        </div>
    </div>
</div>

<!-- Memory Modal — Quiet Archive -->
<div id="memoryModal" class="profile-modal" style="display: none;" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="memoryModalTitle">
