<!-- 3-Dot Menu Icon Button -->
<button
    class="menu-icon"
    onclick="toggleMenuDropdown()"
    aria-label="Menu"
    id="menuIcon"
>
    <i class="fas fa-ellipsis-v"></i>
</button>

<!-- Menu Dropdown — minimal -->
<div id="menuDropdown" class="menu-dropdown" style="display: none;" role="menu" aria-hidden="true">
    <div class="menu-dropdown-content">
        <div class="menu-tier-badge" id="menuTierBadge">
            <i class="fas fa-user"></i>
            <span id="tierBadgeText">Free Tier</span>
        </div>

        <div class="menu-item" onclick="openProfile()" role="menuitem">
            <i class="fas fa-user"></i>
            <span>Profile</span>
        </div>

        <div class="menu-item" onclick="openMemory()" role="menuitem">
            <i class="fas fa-brain"></i>
            <span>Memory</span>
        </div>

        <div class="menu-item" onclick="toggleThemeSubmenu()" role="menuitem" aria-haspopup="true">
            <i class="fas fa-palette"></i>
            <span>Theme</span>
            <i class="fas fa-chevron-right menu-item-arrow"></i>
        </div>

        <div id="themeSubmenu" class="theme-submenu" style="display: none;">
            <div class="menu-item theme-option" onclick="setTheme('light')">
                <i class="fas fa-sun"></i>
                <span>Light</span>
                <i class="fas fa-check theme-check" id="lightCheck" style="display: none;"></i>
            </div>
            <div class="menu-item theme-option" onclick="setTheme('dark')">
                <i class="fas fa-moon"></i>
                <span>Dark</span>
                <i class="fas fa-check theme-check" id="darkCheck" style="display: none;"></i>
            </div>
        </div>

        <div class="menu-item menu-item-upgrade" id="upgradeMenuItem" onclick="openUpgrade()" style="display: none;" role="menuitem">
            <i class="fas fa-star"></i>
            <span>Upgrade to Pro</span>
        </div>

        <div class="menu-item menu-item-danger" onclick="handleLogout()" role="menuitem">
            <i class="fas fa-sign-out-alt"></i>
            <span>Sign out</span>
        </div>
    </div>
</div>

<!-- Profile Modal — Retro Dossier -->
<div id="profileModal" class="profile-modal" style="display: none;" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="profileModalTitle">
    <div class="profile-modal-content retro-dossier">
        <!-- Top rule / eyebrow -->
        <div class="dossier-topbar">
            <div class="dossier-eyebrow">
                <span class="eyebrow-mark"></span>
                <span>RETRO</span>
                <span class="eyebrow-dot">·</span>
                <span>IDENTITY</span>
                <span class="eyebrow-catalog" id="profileCatalogNo">DOSSIER — 001</span>
            </div>
            <button onclick="closeProfile()" class="dossier-close" aria-label="Close profile">
                <i class="fas fa-times"></i>
            </button>
        </div>

        <!-- Hero -->
        <div class="dossier-hero">
            <div class="avatar-wrap">
                <div class="profile-avatar" id="profileAvatar">
                    <span id="profileInitials" class="avatar-initials">R</span>
                    <i id="profileAvatarIcon" class="fas fa-user avatar-icon" style="display:none;"></i>
                </div>
                <span class="avatar-tier-dot tier-free" id="profileTierDot" aria-hidden="true"></span>
            </div>
            <div class="hero-copy">
                <div class="hero-name-row">
                    <h2 id="profileName" class="dossier-name">Loading...</h2>
                    <span id="profileVerified" class="verified-pill" style="display: none;">
                        <i class="fas fa-check"></i> Verified
                    </span>
                </div>
                <p id="profileUsername" class="dossier-username">@username</p>
                <p id="profileEmailHero" class="dossier-email-hero">email@example.com</p>
            </div>
        </div>

        <!-- Ledger -->
        <div class="dossier-ledger">
            <div class="ledger-row">
                <div class="ledger-cell">
                    <span class="ledger-label">EMAIL</span>
                    <span class="ledger-value" id="profileEmail">email@example.com</span>
                </div>
                <div class="ledger-cell">
                    <span class="ledger-label">MEMBER SINCE</span>
                    <span class="ledger-value" id="profileJoined">—</span>
                </div>
            </div>
            <div class="ledger-row">
                <div class="ledger-cell">
                    <span class="ledger-label">TIER</span>
                    <span class="ledger-value ledger-tier">
                        <i id="profileTierIcon" class="fas fa-user tier-icon"></i>
                        <span id="profileTier">Free Tier</span>
                    </span>
                </div>
                <div class="ledger-cell">
                    <span class="ledger-label">STATUS</span>
                    <span class="ledger-value" id="profileStatus">Active</span>
                </div>
            </div>
        </div>

        <!-- Tier CTA strip -->
        <div class="dossier-tier-strip tier-free" id="profileTierStrip">
            <div class="tier-strip-copy">
                <i id="profileTierStripIcon" class="fas fa-leaf"></i>
                <div>
                    <p class="tier-strip-title" id="profileTierStripTitle">Free — Starter dossier</p>
                    <p class="tier-strip-sub" id="profileTierStripSub">25 notes · 100 cards · Basic chat</p>
                </div>
            </div>
            <button class="tier-strip-action" id="profileTierAction" onclick="openUpgrade()">
                <span id="profileTierActionText">Upgrade</span>
                <i class="fas fa-arrow-right"></i>
            </button>
        </div>

        <!-- Footer actions -->
        <div class="dossier-footer">
            <span class="footer-hint">Signed in as <strong id="profileFooterUser">@user</strong></span>
            <div class="footer-actions">
                <button class="footer-link" onclick="closeProfile(); openMemory();">Memory</button>
                <span class="footer-dot">·</span>
                <button class="footer-link footer-link-danger" onclick="handleLogout()">Sign out</button>
            </div>
        </div>
    </div>
</div>

<!-- Memory Modal — Dossier Archive -->
<div id="memoryModal" class="profile-modal" style="display: none;" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="memoryModalTitle">
    <div class="profile-modal-content retro-dossier">
        <div class="dossier-topbar">
            <div class="dossier-eyebrow">
                <span class="eyebrow-mark"></span>
                <span>RETRO</span>
                <span class="eyebrow-dot">·</span>
                <span>MEMORY</span>
            </div>
            <button onclick="closeMemory()" class="dossier-close" aria-label="Close memory">
                <i class="fas fa-times"></i>
            </button>
        </div>

        <div class="memory-ledger minimal">
            <div class="memory-text dossier-memory-text" id="memoryText">
                <p>Loading...</p>
            </div>
        </div>

        <div class="dossier-footer">
            <span class="footer-hint">Updates after each chat</span>
            <div class="footer-actions">
                <button class="footer-link" onclick="closeMemory()">Done</button>
                <span class="footer-dot">·</span>
                <button class="footer-link footer-link-danger" onclick="handleClearMemory()">Clear</button>
            </div>
        </div>
    </div>
</div>

