        <div class="menu-item" onclick="openMemory()" role="menuitem">
            <i class="fas fa-brain"></i>
            <span>Memory</span>
        </div>

        <div class="menu-item" onclick="toggleThemeSubmenu()" role="menuitem" aria-haspopup="true">
            <i class="fas fa-palette"></i>
            <span>Theme</span>
            <i class="fas fa-chevron-right menu-item-arrow"></i>
        </div>

