<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Welcome | Retro</title>
    <link rel="stylesheet" href="/css/tailwind.css?v=<%= assetVersion %>" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        :root {
            --bg-primary: #fafafa;
            --bg-secondary: #ffffff;
            --bg-tertiary: #f5f5f5;
            --text-primary: #1a1a1a;
            --text-secondary: #666666;
            --text-muted: #9a9a9a;
            --accent-primary: #6366f1;
            --accent-secondary: #8b5cf6;
            --border-color: rgba(0, 0, 0, 0.08);
            --shadow: rgba(0, 0, 0, 0.08);
            --shadow-lg: rgba(0, 0, 0, 0.14);
        }
        [data-theme="dark"] {
            --bg-primary: #262624;
            --bg-secondary: #141413;
            --bg-tertiary: #1a1a18;
            --text-primary: #c2c0b6;
            --text-secondary: #a8a6a0;
            --text-muted: #888682;
            --accent-primary: #818cf8;
            --accent-secondary: #a78bfa;
            --border-color: rgba(194, 192, 182, 0.13);
            --shadow: rgba(0, 0, 0, 0.35);
            --shadow-lg: rgba(0, 0, 0, 0.5);
        }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: "IBM Plex Sans", sans-serif;
            background: var(--bg-primary);
            color: var(--text-primary);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1.5rem;
            -webkit-font-smoothing: antialiased;
            transition: background 0.3s ease, color 0.3s ease;
        }
        .accent { font-family: "Space Grotesk", sans-serif; }

        .wizard-card {
            background: var(--bg-secondary);
            border: 1px solid var(--border-color);
            border-radius: 24px;
            box-shadow: 0 18px 48px var(--shadow-lg);
            width: 100%;
            max-width: 540px;
            overflow: hidden;
        }
        .progress-track {
            height: 4px;
            background: var(--bg-tertiary);
        }
        .progress-bar {
            height: 100%;
            background: linear-gradient(90deg, var(--accent-primary), var(--accent-secondary));
            transition: width 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            border-radius: 0 2px 2px 0;
        }
        .step-body { display: none; animation: fadeUp 0.35s ease both; }
        .step-body.active { display: block; }
        @keyframes fadeUp {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .step-kicker {
            font-family: "Space Grotesk", sans-serif;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.16em;
            text-transform: uppercase;
            color: var(--accent-primary);
        }
        .step-title {
            font-family: "Space Grotesk", sans-serif;
            font-size: 1.6rem;
            font-weight: 700;
            line-height: 1.25;
            margin: 0.5rem 0 0.4rem;
        }
        .step-sub { font-size: 0.92rem; color: var(--text-secondary); line-height: 1.55; }

        .text-input {
            width: 100%;
            padding: 0.85rem 1rem;
            border-radius: 14px;
            border: 1.5px solid var(--border-color);
            background: var(--bg-primary);
            color: var(--text-primary);
            font-family: "IBM Plex Sans", sans-serif;
            font-size: 1rem;
            outline: none;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }
        .text-input:focus {
            border-color: var(--accent-primary);
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15);
        }
        .text-input::placeholder { color: var(--text-muted); }
        textarea.text-input { resize: vertical; min-height: 110px; }

        .chip {
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            padding: 0.6rem 1rem;
            border-radius: 999px;
            border: 1.5px solid var(--border-color);
            background: var(--bg-primary);
            color: var(--text-primary);
            font-size: 0.88rem;
            font-weight: 500;
            cursor: pointer;
            user-select: none;
            transition: all 0.18s ease;
        }
        .chip:hover { border-color: var(--accent-primary); transform: translateY(-1px); }
        .chip.selected {
            background: var(--accent-primary);
            border-color: var(--accent-primary);
            color: #ffffff;
        }
        [data-theme="dark"] .chip.selected { color: #141413; }
        .chip i { font-size: 0.75rem; }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            padding: 0.8rem 1.6rem;
            border-radius: 14px;
            font-family: "Space Grotesk", sans-serif;
            font-size: 0.95rem;
            font-weight: 600;
            cursor: pointer;
            border: none;
            transition: all 0.2s ease;
        }
        .btn-primary {
            background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary));
            color: #ffffff;
            box-shadow: 0 6px 16px var(--shadow);
        }
        .btn-primary:hover { transform: translateY(-1px); box-shadow: 0 10px 22px var(--shadow-lg); }
        .btn-primary:disabled { opacity: 0.55; cursor: not-allowed; transform: none; }
        .btn-ghost {
            background: transparent;
            color: var(--text-secondary);
            border: 1.5px solid var(--border-color);
        }
        .btn-ghost:hover { color: var(--text-primary); border-color: var(--text-muted); }
        .btn-link {
            background: none;
            border: none;
            color: var(--text-muted);
            font-size: 0.85rem;
            font-weight: 500;
            cursor: pointer;
            padding: 0.5rem;
        }
        .btn-link:hover { color: var(--text-primary); }

        .field-error {
            display: none;
            color: #ef4444;
            font-size: 0.8rem;
            margin-top: 0.4rem;
        }
        .field-error.show { display: block; }

        .toast {
            position: fixed;
            top: 20px;
            right: 20px;
            background-color: #ef4444;
            color: white;
            padding: 14px 22px;
            border-radius: 12px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            display: flex;
            align-items: center;
            gap: 10px;
            z-index: 1000;
            animation: slideIn 0.3s ease-out;
            max-width: 380px;
            font-size: 0.9rem;
        }
        @keyframes slideIn {
            from { transform: translateX(400px); opacity: 0; }
            to { transform: translateX(0); opacity: 1; }
        }

        .spinner {
            width: 16px;
            height: 16px;
            border: 2px solid rgba(255, 255, 255, 0.4);
            border-top-color: #fff;
            border-radius: 50%;
            animation: spin 0.7s linear infinite;
        }
        @keyframes spin { to { transform: rotate(360deg); } }

        .dots { display: flex; gap: 0.4rem; }
        .dot {
            width: 8px;
            height: 8px;
            border-radius: 999px;
            background: var(--text-muted);
            opacity: 0.4;
            transition: all 0.3s ease;
        }
        .dot.active { background: var(--accent-primary); opacity: 1; width: 24px; }

        .feature-row {
            display: flex;
            align-items: center;
            gap: 0.8rem;
            padding: 0.7rem 0.9rem;
            border-radius: 14px;
            background: var(--bg-primary);
            border: 1px solid var(--border-color);
        }
        .feature-icon {
            width: 38px;
            height: 38px;
            border-radius: 12px;
            display: grid;
            place-items: center;
            color: #fff;
            flex-shrink: 0;
        }
    </style>
</head>
<body>
    <div class="wizard-card">
        <div class="progress-track"><div class="progress-bar" id="progressBar"></div></div>

        <div class="p-7 sm:p-10">
            <div class="dots mb-6" id="stepDots"></div>

            <!-- Step 1: Welcome + Name -->
            <div class="step-body active" data-step="1">
                <div class="step-kicker">Welcome to Retro</div>
                <h1 class="step-title">Hey <%= user.firstName %>! What should Retro call you?</h1>
                <p class="step-sub mb-6">This is the name your AI study companion will use when talking to you.</p>
                <input type="text" id="displayName" class="text-input" maxlength="50" value="<%= user.firstName %>" placeholder="e.g. Zaid, Champ, Captain..." />
                <div class="field-error" id="displayNameError">Please enter a name (1&ndash;50 characters).</div>
            </div>

            <!-- Step 2: Role -->
            <div class="step-body" data-step="2">
                <div class="step-kicker">About You</div>
                <h1 class="step-title">What do you do?</h1>
                <p class="step-sub mb-6">This helps Retro tailor explanations to your level.</p>
                <div class="flex flex-wrap gap-2" id="roleChips">
                    <span class="chip" data-value="High school student"><i class="fas fa-school"></i>High school student</span>
                    <span class="chip" data-value="College student"><i class="fas fa-graduation-cap"></i>College student</span>
                    <span class="chip" data-value="Exam aspirant"><i class="fas fa-bullseye"></i>Exam aspirant</span>
                    <span class="chip" data-value="Working professional"><i class="fas fa-briefcase"></i>Working professional</span>
                    <span class="chip" data-value="Casual learner"><i class="fas fa-book-open"></i>Casual learner</span>
                </div>
                <div class="field-error" id="roleError">Please pick one.</div>
            </div>

            <!-- Step 3: Subjects -->
            <div class="step-body" data-step="3">
                <div class="step-kicker">Your Studies</div>
                <h1 class="step-title">What are you studying?</h1>
                <p class="step-sub mb-6">Pick your subjects &mdash; you can add your own too. <span class="font-medium" style="color:var(--text-primary)">Optional.</span></p>
                <div class="flex flex-wrap gap-2" id="subjectChips">
                    <span class="chip" data-value="Mathematics"><i class="fas fa-square-root-variable"></i>Mathematics</span>
                    <span class="chip" data-value="Physics"><i class="fas fa-atom"></i>Physics</span>
                    <span class="chip" data-value="Chemistry"><i class="fas fa-flask"></i>Chemistry</span>
                    <span class="chip" data-value="Biology"><i class="fas fa-dna"></i>Biology</span>
                    <span class="chip" data-value="Computer Science"><i class="fas fa-code"></i>Computer Science</span>
                    <span class="chip" data-value="Data Structures"><i class="fas fa-sitemap"></i>Data Structures</span>
                    <span class="chip" data-value="Databases"><i class="fas fa-database"></i>Databases</span>
                    <span class="chip" data-value="History"><i class="fas fa-landmark"></i>History</span>
                    <span class="chip" data-value="Economics"><i class="fas fa-chart-line"></i>Economics</span>
                    <span class="chip" data-value="English"><i class="fas fa-language"></i>English</span>
                </div>
                <div class="mt-4 flex gap-2">
                    <input type="text" id="customSubject" class="text-input" style="flex:1" maxlength="40" placeholder="Add your own subject..." />
                    <button type="button" class="btn btn-ghost" style="padding: 0.6rem 1rem" id="addSubjectBtn"><i class="fas fa-plus"></i></button>
                </div>
            </div>

            <!-- Step 4: Goal -->
            <div class="step-body" data-step="4">
                <div class="step-kicker">Your Goal</div>
                <h1 class="step-title">What's your main goal right now?</h1>
                <p class="step-sub mb-6">A target helps Retro keep every answer pointed at what matters to you. <span class="font-medium" style="color:var(--text-primary)">Optional.</span></p>
                <textarea id="goal" class="text-input" maxlength="200" placeholder="e.g. Crack JEE 2026, survive finals in December, master DSA for interviews..."></textarea>
            </div>

            <!-- Step 5: Style -->
            <div class="step-body" data-step="5">
                <div class="step-kicker">How Retro Talks</div>
                <h1 class="step-title">How should Retro answer you?</h1>
                <p class="step-sub mb-6">You can change your mind anytime by just telling Retro in chat.</p>
                <p class="text-sm font-semibold mb-2" style="color:var(--text-primary)">Answer length</p>
                <div class="flex flex-wrap gap-2 mb-5" id="styleChips">
                    <span class="chip" data-value="crisp"><i class="fas fa-bolt"></i>Crisp</span>
                    <span class="chip selected" data-value="balanced"><i class="fas fa-align-left"></i>Balanced</span>
                    <span class="chip" data-value="detailed"><i class="fas fa-layer-group"></i>Detailed</span>
                </div>
                <p class="text-sm font-semibold mb-2" style="color:var(--text-primary)">Vibe</p>
                <div class="flex flex-wrap gap-2" id="toneChips">
                    <span class="chip selected" data-value="casual"><i class="fas fa-mug-hot"></i>Casual</span>
                    <span class="chip" data-value="formal"><i class="fas fa-user-tie"></i>Formal</span>
                </div>
            </div>

            <!-- Step 6: Anything else -->
            <div class="step-body" data-step="6">
                <div class="step-kicker">One Last Thing</div>
                <h1 class="step-title">Anything else you want Retro to remember?</h1>
                <p class="step-sub mb-6">Durable instructions work best &mdash; things like "explain with code examples", "I'm preparing for JEE 2026", or "I study best in the morning". <span class="font-medium" style="color:var(--text-primary)">Optional.</span></p>
                <textarea id="anythingElse" class="text-input" maxlength="500" placeholder="Tell Retro anything it should always keep in mind..."></textarea>
            </div>

            <!-- Step 7: Review + finish -->
            <div class="step-body" data-step="7">
                <div class="step-kicker">All Set</div>
                <h1 class="step-title">Ready, <span id="reviewName"></span>?</h1>
                <p class="step-sub mb-6">Here's what Retro knows so far. Hit finish and let's study.</p>
                <div class="space-y-2 mb-2" id="reviewList"></div>
            </div>

            <!-- Navigation -->
            <div class="flex items-center justify-between mt-8 pt-5" style="border-top:1px solid var(--border-color)">
                <button type="button" class="btn btn-ghost" id="backBtn" style="visibility:hidden">
                    <i class="fas fa-arrow-left"></i> Back
                </button>
                <div class="flex items-center gap-3">
                    <button type="button" class="btn-link" id="skipBtn">Skip</button>
                    <button type="button" class="btn btn-primary" id="nextBtn">
                        Next <i class="fas fa-arrow-right"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script>
        const TOTAL_STEPS = 7;
        const OPTIONAL_STEPS = new Set([3, 4, 6]);
        let currentStep = 1;
        const state = {
            displayName: "",
            role: "",
            subjects: [],
            goal: "",
            answerStyle: "balanced",
            tone: "casual",
            anythingElse: "",
        };

        // ---------- theme ----------
        (function loadTheme() {
            const saved = localStorage.getItem("theme");
            if (saved === "dark") document.body.setAttribute("data-theme", "dark");
        })();

        // ---------- step dots ----------
        const dotsEl = document.getElementById("stepDots");
        for (let i = 1; i <= TOTAL_STEPS; i++) {
            const d = document.createElement("div");
            d.className = "dot" + (i === 1 ? " active" : "");
            dotsEl.appendChild(d);
        }

        // ---------- navigation ----------
        const backBtn = document.getElementById("backBtn");
        const nextBtn = document.getElementById("nextBtn");
        const skipBtn = document.getElementById("skipBtn");

        function showToast(message) {
            const t = document.createElement("div");
            t.className = "toast";
            t.innerHTML = '<i class="fas fa-exclamation-circle"></i><span></span>';
            t.querySelector("span").textContent = message;
            document.body.appendChild(t);
            setTimeout(() => t.remove(), 4000);
        }

        function collectStep(step) {
            if (step === 1) {
                const val = document.getElementById("displayName").value.trim();
                const err = document.getElementById("displayNameError");
                if (!val || val.length > 50) {
                    err.classList.add("show");
                    return false;
                }
                err.classList.remove("show");
                state.displayName = val;
            }
            if (step === 2) {
                if (!state.role) {
                    document.getElementById("roleError").classList.add("show");
                    return false;
                }
                document.getElementById("roleError").classList.remove("show");
            }
            return true;
        }

        function buildReview() {
            document.getElementById("reviewName").textContent = state.displayName;
            const list = document.getElementById("reviewList");
            const rows = [
                ["fa-signature", "Call me", state.displayName],
                ["fa-user", "I am a", state.role],
                ["fa-book", "Studying", state.subjects.length ? state.subjects.join(", ") : null],
                ["fa-bullseye", "Goal", state.goal],
                ["fa-comment-dots", "Answer style", `${state.answerStyle} \u00b7 ${state.tone}`],
                ["fa-lightbulb", "Remember", state.anythingElse],
            ];
            list.innerHTML = "";
            for (const [icon, label, value] of rows) {
                if (!value) continue;
                const row = document.createElement("div");
                row.className = "feature-row";
                const iconEl = document.createElement("div");
                iconEl.className = "feature-icon";
                iconEl.style.background = "linear-gradient(135deg, var(--accent-primary), var(--accent-secondary))";
                iconEl.innerHTML = `<i class="fas ${icon}" style="font-size:0.85rem"></i>`;
                const textEl = document.createElement("div");
                const labelEl = document.createElement("div");
                labelEl.style.cssText = "font-size:0.7rem;text-transform:uppercase;letter-spacing:0.1em;color:var(--text-muted);font-weight:600";
                labelEl.textContent = label;
                const valueEl = document.createElement("div");
                valueEl.style.cssText = "font-size:0.9rem;color:var(--text-primary);font-weight:500;word-break:break-word";
                valueEl.textContent = value;
                textEl.append(labelEl, valueEl);
                row.append(iconEl, textEl);
                list.appendChild(row);
            }
        }

        function goTo(step) {
            if (step < 1 || step > TOTAL_STEPS) return;
            currentStep = step;
            document.querySelectorAll(".step-body").forEach((el) => {
                el.classList.toggle("active", Number(el.dataset.step) === step);
            });
            document.querySelectorAll(".dot").forEach((d, i) => {
                d.classList.toggle("active", i + 1 === step);
            });
            document.getElementById("progressBar").style.width = `${(step / TOTAL_STEPS) * 100}%`;
            backBtn.style.visibility = step === 1 ? "hidden" : "visible";
            skipBtn.style.display = OPTIONAL_STEPS.has(step) ? "inline-block" : "none";
            if (step === TOTAL_STEPS) {
                nextBtn.innerHTML = 'Finish <i class="fas fa-check"></i>';
                buildReview();
            } else {
                nextBtn.innerHTML = 'Next <i class="fas fa-arrow-right"></i>';
            }
        }

        async function submitSetup() {
            const original = nextBtn.innerHTML;
            nextBtn.disabled = true;
            nextBtn.innerHTML = '<span class="spinner"></span> Setting up...';
            try {
                const res = await fetch("/api/v1/onboarding", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    credentials: "include",
                    body: JSON.stringify(state),
                });
                const data = await res.json();
                if (res.ok && data.success) {
                    window.location.href = "/app";
                    return;
                }
                showToast(data.message || data.errors?.[0]?.message || "Setup failed. Please try again.");
            } catch (err) {
                console.error("Setup error:", err);
                showToast("An error occurred. Please try again.");
            }
            nextBtn.disabled = false;
            nextBtn.innerHTML = original;
        }

        nextBtn.addEventListener("click", () => {
            if (!collectStep(currentStep)) return;
            if (currentStep === TOTAL_STEPS) {
                submitSetup();
            } else {
                goTo(currentStep + 1);
            }
        });

        backBtn.addEventListener("click", () => goTo(currentStep - 1));

        // Skip = jump straight to the final review/submit step
        skipBtn.addEventListener("click", () => {
            if (currentStep === 1 && !collectStep(1)) return;
            goTo(TOTAL_STEPS);
        });

        // Enter advances (except inside textareas)
        document.addEventListener("keydown", (e) => {
            if (e.key === "Enter" && e.target.tagName !== "TEXTAREA") {
                e.preventDefault();
                nextBtn.click();
            }
        });

        // ---------- chips ----------
        function wireSingleSelect(containerId, key) {
            const container = document.getElementById(containerId);
            container.addEventListener("click", (e) => {
                const chip = e.target.closest(".chip");
                if (!chip) return;
                container.querySelectorAll(".chip").forEach((c) => c.classList.remove("selected"));
                chip.classList.add("selected");
                state[key] = chip.dataset.value;
            });
        }
        wireSingleSelect("roleChips", "role");
        wireSingleSelect("styleChips", "answerStyle");
        wireSingleSelect("toneChips", "tone");

        // Subjects: multi-select + custom add
        const subjectChips = document.getElementById("subjectChips");
        subjectChips.addEventListener("click", (e) => {
            const chip = e.target.closest(".chip");
            if (!chip) return;
            chip.classList.toggle("selected");
            state.subjects = [...subjectChips.querySelectorAll(".chip.selected")].map((c) => c.dataset.value);
        });

        function addCustomSubject() {
            const input = document.getElementById("customSubject");
            const value = input.value.trim();
            if (!value) return;
            if (state.subjects.includes(value)) {
                input.value = "";
                return;
            }
            if (state.subjects.length >= 10) {
                showToast("You can track up to 10 subjects.");
                return;
            }
            const chip = document.createElement("span");
            chip.className = "chip selected";
            chip.dataset.value = value;
            chip.innerHTML = `<i class="fas fa-tag"></i>`;
            chip.appendChild(document.createTextNode(value));
            subjectChips.appendChild(chip);
            state.subjects.push(value);
            input.value = "";
        }
        document.getElementById("addSubjectBtn").addEventListener("click", addCustomSubject);
        document.getElementById("customSubject").addEventListener("keydown", (e) => {
            if (e.key === "Enter") {
                e.preventDefault();
                e.stopPropagation();
                addCustomSubject();
            }
        });

        document.getElementById("goal").addEventListener("input", (e) => (state.goal = e.target.value.trim()));
        document.getElementById("anythingElse").addEventListener("input", (e) => (state.anythingElse = e.target.value.trim()));

        goTo(1);
    </script>
</body>
</html>
